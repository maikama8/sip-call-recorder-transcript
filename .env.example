# Copy to .env and fill in the values you need.
# The app runs offline with the defaults below.

# fake | openai | faster_whisper
TRANSCRIPTION_PROVIDER=fake

# Required only when TRANSCRIPTION_PROVIDER=openai.
OPENAI_API_KEY=

# Optional OpenAI-compatible API root.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TIMEOUT_SECONDS=60

# Used when TRANSCRIPTION_PROVIDER=faster_whisper.
# Install the extra first: pip install faster-whisper
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# SQLite file and the directory copied recordings are written to.
DATABASE_URL=sqlite:///./data/calls.db
RECORDINGS_DIR=./data/recordings

# Asterisk/FreePBX monitor spool. Leave empty to disable watching.
# FreePBX uses /var/spool/asterisk/monitor (files live in YYYY/MM/DD/).
MONITOR_DIR=
CDR_PATH=
WATCH_ENABLED=false
WATCH_INTERVAL_SECONDS=5
WATCH_SETTLE_SECONDS=5

# Maximum upload size in bytes (default 25 MiB).
MAX_UPLOAD_BYTES=26214400
DEFAULT_LANGUAGE=en
